{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gh": "GITHUB_PAGES=true vite build",
    "deploy:gh": "npm run build:gh && gh-pages -d dist",
    "lint": "eslint .",
